---
import { company } from '../data/company';
import Icon from './Icon.astro';
---
<footer class="footer">
  <div class="container-wide">
    <div class="footer-word">BADESTRAND</div>
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-statement">Natürlich. Wirksam. Zeitlos.</p>
        <p class="footer-sub">Gezielte Wirkstoffpflege aus Deutschland.</p>
      </div>
      <div class="footer-group">
        <button class="footer-group-toggle" aria-expanded="false" aria-controls="footer-links-produkte" data-footer-toggle><h4>Produkte</h4></button>
        <div class="footer-group-links" id="footer-links-produkte"><a href="/produkte/">Alle Produkte</a><a href="/hautbeduerfnisse/">Hautbedürfnisse</a><a href="/inhaltsstoffe/">Wirkstoffe</a><a href="/wirkung-studien/">Wirkung & Studien</a></div>
      </div>
      <div class="footer-group">
        <button class="footer-group-toggle" aria-expanded="false" aria-controls="footer-links-badestrand" data-footer-toggle><h4>Badestrand</h4></button>
        <div class="footer-group-links" id="footer-links-badestrand"><a href="/ueber-uns/">Über uns</a><a href="/beratung/">Beratung</a><a href="/magazin/">Magazin</a><a href="/kontakt/">Kontakt</a></div>
      </div>
      <div class="footer-group">
        <button class="footer-group-toggle" aria-expanded="false" aria-controls="footer-links-service" data-footer-toggle><h4>Service</h4></button>
        <div class="footer-group-links" id="footer-links-service"><a href="/versand-zahlung/">Versand & Zahlung</a><a href="/agb/">AGB</a><a href="/widerruf/">Widerruf</a><a href="/datenschutz/">Datenschutz</a><a href="/cookie-richtlinie/">Cookie-Richtlinie</a><a href="/gesetzliche-gewaehrleistung/">Gesetzliche Gewährleistung</a><a href="/impressum/">Impressum</a></div>
      </div>
    </div>
    <div class="footer-contact">
      <span><Icon name="location" size={16} />{company.address.street} · {company.address.postalCode} {company.address.city}</span>
      <span><a href={`tel:${company.phone}`}><Icon name="phone" size={16} />{company.phoneDisplay}</a></span>
      <span><a href={`mailto:${company.email}`}><Icon name="mail" size={16} />{company.email}</a></span>
      <span><Icon name="clock" size={16} />{company.serviceHours.days} {company.serviceHours.time}</span>
    </div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} {company.legalName}</span></div>
  </div>
</footer>
<script>
  document.querySelectorAll('[data-footer-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.closest('.footer-group')?.classList.toggle('open', !expanded);
    });
  });
</script>
