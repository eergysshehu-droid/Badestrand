---
const { current = '' } = Astro.props;
const nav = [
  ['Produkte','/produkte/','produkte'],
  ['Problemlösungen','/problemloesungen/','problemloesungen'],
  ['Inhaltsstoffe','/inhaltsstoffe/','inhaltsstoffe'],
  ['Über uns','/ueber-uns/','ueber-uns'],
  ['Magazin','/magazin/','magazin'],
  ['Kontakt','/kontakt/','kontakt']
];
---
<div class="announcement">Wirksame Pflege. Natürlich gedacht. · In Deutschland hergestellt · Persönliche Beratung</div>
<header class="header">
  <div class="container header-inner">
    <button class="icon mobile-menu" aria-label="Menü öffnen" aria-expanded="false" aria-controls="main-nav" data-menu>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <a class="logo" href="/"><img src="/images/logo.webp" alt="Badestrand Kosmetik" /></a>
    <nav class="nav" id="main-nav" data-nav>
      {nav.map(([label, href, key]) => <a class={current===key ? 'active':''} href={href}>{label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="icon" href="/warenkorb/" aria-label="Warenkorb">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
      </a>
    </div>
  </div>
</header>
<script>
  const menuBtn = document.querySelector('[data-menu]');
  const nav = document.querySelector('[data-nav]');
  menuBtn?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
</script>
