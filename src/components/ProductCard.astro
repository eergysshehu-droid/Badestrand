---
import { localizePath } from '../i18n/utils';
import { concerns } from '../data/concerns';
import { concernsEn } from '../data/concerns.en';
const { product, lang = 'de' } = Astro.props;
const photoSoon = lang === 'en' ? 'Photo coming soon' : 'Foto folgt';
const concernList = lang === 'en' ? concernsEn : concerns;
const skinNeed = concernList.find((c) => c.productSlugs.includes(product.slug));
---
<a class="product-card" href={localizePath(`/produkte/${product.slug}/`, lang)} data-category={product.category}>
  <div class="product-visual">
    {product.image
      ? <img src={product.image} alt={product.name} loading="lazy" />
      : <div class="product-visual-placeholder"><span>{product.name.slice(0, 1)}</span><small>{photoSoon}</small></div>}
  </div>
  <div class="product-copy">
    <div class="micro">{product.eyebrow}</div>
    <h3>{product.name}</h3>
    <p>{product.description}</p>
    {skinNeed && <span class="product-skin-need">{skinNeed.title}</span>}
    {product.priceVerified && <div class="product-price">{product.price}</div>}
  </div>
</a>
