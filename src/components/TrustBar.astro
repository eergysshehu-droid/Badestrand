---
import Icon from './Icon.astro';
---
<div class="trust">
  <div class="container trust-grid">
    <div class="trust-item">
      <Icon name="leaf" class="trust-icon" size={26} />
      <span>Natürliche<br>Inhaltsstoffe</span>
    </div>
    <div class="trust-item">
      <Icon name="flask" class="trust-icon" size={26} />
      <span>Dermatologisch<br>geprüft*</span>
    </div>
    <div class="trust-item">
      <Icon name="germany" class="trust-icon" size={26} />
      <span>Made in<br>Germany</span>
    </div>
    <div class="trust-item">
      <Icon name="shieldCheck" class="trust-icon" size={26} />
      <span>Ohne<br>Parabene</span>
    </div>
  </div>
</div>
