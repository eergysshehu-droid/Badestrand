---
import Icon from './Icon.astro';

const { lang = 'de' } = Astro.props;
const items = {
  de: [
    ['leaf', 'Natürliche Inhaltsstoffe'],
    ['flask', 'Dermatologisch geprüft*'],
    ['germany', 'Made in Germany'],
    ['consultation', 'Persönliche Beratung']
  ],
  en: [
    ['leaf', 'Natural Ingredients'],
    ['flask', 'Dermatologically tested*'],
    ['germany', 'Made in Germany'],
    ['consultation', 'Personal Consultation']
  ]
};
const trust = items[lang] ?? items.de;
const ariaLabel = lang === 'en' ? "Badestrand quality marks" : 'Badestrand Qualitätsmerkmale';
---
<div class="trust-marquee" aria-label={ariaLabel}>
  <div class="trust-marquee__track">
    <div class="trust-marquee__group">
      {trust.map(([icon, label]) => (
        <div class="trust-marquee__item">
          <Icon name={icon} size={23} />
          <span>{label}</span>
        </div>
      ))}
    </div>
    <div class="trust-marquee__group" aria-hidden="true">
      {trust.map(([icon, label]) => (
        <div class="trust-marquee__item">
          <Icon name={icon} size={23} />
          <span>{label}</span>
        </div>
      ))}
    </div>
  </div>
</div>
