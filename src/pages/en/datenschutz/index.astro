---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { companyEn as company } from '../../../data/company.en';
---
<SiteLayout title="Privacy Policy | Badestrand Kosmetik" current="datenschutz" description="Privacy policy of Badestrand Kosmetik GmbH pursuant to the GDPR.">
<section class="page-hero"><div class="container"><div class="eyebrow">Legal</div><h1>Privacy Policy</h1></div></section>
<section class="section"><div class="container legal-content">
  <div class="legal-notice"><strong>In preparation:</strong> The complete, GDPR-compliant privacy policy is currently being drafted (covering hosting, cookies, contact form, newsletter, analytics tools) and will be published here before shop launch.</div>
  <h2>1. Data Controller</h2>
  <p>{company.legalName}<br>{company.address.street}, {company.address.postalCode} {company.address.city}<br>Email: <a href={`mailto:${company.email}`}>{company.email}</a></p>
  <h2>2. Collection and Processing of Personal Data</h2>
  <h2>3. Cookies</h2>
  <p>For more information, see our <a href="/en/cookie-richtlinie/">Cookie Policy</a>.</p>
  <h2>4. Your Rights</h2>
  <h2>5. Contact for Privacy Questions</h2>
</div></section>
</SiteLayout>
