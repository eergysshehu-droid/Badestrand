---
import SiteLayout from '../../../layouts/SiteLayout.astro';
---
<SiteLayout title="Cart | Badestrand Kosmetik">
<section class="page-hero"><div class="container"><div class="eyebrow">Your Selection</div><h1>Cart</h1><p class="lead">Reduced to the essentials — so the path to checkout stays calm, clear and quick.</p></div></section>
<section class="section"><div class="container cart-grid"><div><div class="cart-row"><img src="/images/hornhaut.webp" alt=""><div><h3>Hornhaut Balsam</h3><p>30 ml</p><select><option>1</option><option>2</option></select></div><div class="product-price">7.25 €</div></div><div class="cart-row"><img src="/images/aloe.webp" alt=""><div><h3>Aloe Hyaluron Booster</h3><p>50 ml</p><select><option>1</option><option>2</option></select></div><div class="note">Price to be confirmed before launch.</div></div></div><aside class="cart-summary"><h3>Order summary</h3><div class="total"><span>Subtotal</span><strong>—</strong></div><div class="total"><span>Shipping</span><span>calculated</span></div><div class="total big"><span>Total</span><span>—</span></div><button class="btn" style="width:100%;margin-top:16px">Checkout →</button><p class="note">Checkout, payment, inventory and order handling will be connected to a commerce system later.</p></aside></div></section>
</SiteLayout>
