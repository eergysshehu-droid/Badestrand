---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Icon from '../../../components/Icon.astro';
import { productsEn as products } from '../../../data/products.en';
import { companyEn as company } from '../../../data/company.en';

const verifiedResults = products.filter((p) => p.efficacy);
---
<SiteLayout title="Results & Studies | Badestrand Kosmetik" current="wirkung-studien" description="How Badestrand Kosmetik documents test results and which specific product they are attributed to.">
<section class="page-hero"><div class="container-narrow"><div class="eyebrow">Results & Transparency</div><h1>Results belong to the product.</h1><p class="lead">At Badestrand Kosmetik, test results are always attributed to the specific product they were measured for — never applied broadly across the whole range.</p></div></section>

<section class="section section--standard"><div class="container-narrow">
  <h2>How we handle test results</h2>
  <p class="lead" style="font-size:16px;color:var(--muted)">Every figure published here is tied to a specific product, a period of use and a frequency of application. Results for one product say nothing about the effectiveness of other products in the range. Results that have not yet been conclusively confirmed are not published here.</p>
</div></section>

<section class="section section--standard soft"><div class="container-wide">
  <div class="section-head"><div><div class="eyebrow">Confirmed Results</div><h2>Tested. Documented. Attributed.</h2></div></div>
  <div class="study-grid">
    {verifiedResults.map((p) => (
      <div class="study-card">
        <div class="study-metric">{p.efficacy!.value}</div>
        <h3>{p.efficacy!.statement}</h3>
        <p>{p.efficacy!.context}</p>
        <a class="text-link" href={`/en/produkte/${p.slug}/`}>To {p.name} →</a>
      </div>
    ))}
  </div>
  <p class="study-note">Further results will be published once they are conclusively confirmed for the respective product.</p>
</div></section>

<section class="section section--standard"><div class="container">
  <div class="section-head"><div><div class="eyebrow">Principles</div><h2>What a result means to us.</h2></div></div>
  <div class="grid-3">
    <div class="ingredient"><div class="dot"><Icon name="flask" size={22} /></div><h3>Product-specific</h3><p>A result applies exclusively to the named product and the stated application.</p></div>
    <div class="ingredient"><div class="dot"><Icon name="clock" size={22} /></div><h3>Period & Frequency</h3><p>Every result comes with a duration and frequency of application.</p></div>
    <div class="ingredient"><div class="dot"><Icon name="shieldCheck" size={22} /></div><h3>Confirmed before published</h3><p>Figures without final confirmation don't appear here.</p></div>
  </div>
</div></section>

<section class="section section--standard soft"><div class="container consultation-cta">
  <h2>Questions about a specific product?</h2>
  <p>Our team offers personal consultation — {company.serviceHours.days} {company.serviceHours.time}.</p>
  <div class="btns"><a class="btn" href="/en/beratung/">Contact us →</a><a class="btn outline" href={`tel:${company.phone}`}>{company.phoneDisplay}</a></div>
</div></section>
</SiteLayout>
