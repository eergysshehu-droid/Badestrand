---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import { concerns } from '../../data/concerns';
import { products } from '../../data/products';
import { company } from '../../data/company';

export function getStaticPaths() {
  return concerns.map((concern) => ({
    params: { slug: concern.slug },
    props: { concern }
  }));
}

const { concern } = Astro.props;
const recommended = products.filter((p) => concern.productSlugs.includes(p.slug));
const efficacyProduct = concern.showEfficacyFor ? products.find((p) => p.slug === concern.showEfficacyFor) : undefined;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Hautbedürfnisse', item: `${company.domain}/hautbeduerfnisse/` },
    { '@type': 'ListItem', position: 2, name: concern.title, item: `${company.domain}${concern.href}` }
  ]
};
---
<SiteLayout title={`${concern.title} | Badestrand Kosmetik`} current="hautbeduerfnisse" description={`${concern.subline} Passende Pflege von Badestrand Kosmetik.`}>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
<nav class="breadcrumbs container"><a href="/">Start</a><span>/</span><a href="/hautbeduerfnisse/">Hautbedürfnisse</a><span>/</span><span>{concern.title}</span></nav>

<section class="hero" style="min-height:520px">
  <div class="hero-copy">
    <div class="eyebrow">{concern.eyebrow}</div>
    <h1 class="tight">{concern.title}</h1>
    <p>{concern.subline}</p>
  </div>
  <div class="hero-image" style="min-height:520px"><img src={concern.image} alt={concern.title} /></div>
</section>

<section class="section"><div class="container" style="max-width:760px">
  <p class="lead">{concern.intro}</p>
</div></section>

{recommended.length > 0 && (
  <section class="section soft"><div class="container">
    <div class="section-head"><div><div class="eyebrow">Passende Pflege</div><h2>Empfohlene Produkte.</h2></div></div>
    <div class="product-grid">{recommended.map((p) => <ProductCard product={p} />)}</div>
  </div></section>
)}

{concern.ingredientNames.length > 0 && (
  <section class="section"><div class="container">
    <div class="section-head"><div><div class="eyebrow">Relevante Wirkstoffe</div><h2>Was die Haut braucht.</h2></div><a class="btn outline" href="/inhaltsstoffe/">Alle Wirkstoffe →</a></div>
    <div class="concern-ingredient-row">
      {concern.ingredientNames.map((name) => (
        <a class="concern-ingredient" href="/inhaltsstoffe/">
          <div class="dot"><Icon name="leaf" size={22} /></div>
          <span>{name}</span>
        </a>
      ))}
    </div>
  </div></section>
)}

{efficacyProduct?.efficacy && (
  <section class="section dark"><div class="container proof-split">
    <div class="proof-split-copy">
      <div class="eyebrow">Nachgewiesene Wirkung</div>
      <h2>Ein Ergebnis, dem man vertrauen kann.</h2>
      <a class="text-link" href={`/produkte/${efficacyProduct.slug}/`}>Zum {efficacyProduct.name} →</a>
    </div>
    <div class="proof-split-metric">
      <strong>{efficacyProduct.efficacy.value}</strong>
      <span>{efficacyProduct.efficacy.statement}</span>
      <small>{efficacyProduct.name} · {efficacyProduct.efficacy.context}</small>
    </div>
  </div></section>
)}

<section class="section soft"><div class="container">
  <div class="section-head"><div><div class="eyebrow">Magazin</div><h2>Mehr zu diesem Thema.</h2></div></div>
  <a class="mag-card mag-card-single" href="/magazin/"><div class="content"><h3>{concern.articleTitle}</h3><span>Artikel lesen →</span></div></a>
</div></section>

<section class="section"><div class="container consultation-cta">
  <h2>Nicht sicher, welche Pflege zu Ihnen passt?</h2>
  <p>Wir beraten Sie persönlich – {company.serviceHours.days} {company.serviceHours.time}.</p>
  <div class="btns"><a class="btn" href="/beratung/">Beratung kontaktieren →</a><a class="btn outline" href={`tel:${company.phone}`}>{company.phoneDisplay}</a></div>
</div></section>
</SiteLayout>
