---
import SiteLayout from '../layouts/SiteLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
---
<SiteLayout title="Badestrand Kosmetik — Wirksame Pflege. Natürlich gedacht." ogImage="/images/hero-main.jpg">
<section class="hero">
  <div class="hero-copy">
    <div class="eyebrow">Gezielte Wirkstoffpflege · Made in Germany</div>
    <h1>Schönheit<br>mit Haltung.</h1>
    <p>Wirksame Pflege. Natürlich gedacht. Gezielte Pflege für konkrete Hautbedürfnisse – natürlich formuliert, dermatologisch geprüft wo bestätigt.</p>
    <div class="btns"><a class="btn" href="/produkte/">Produkte entdecken →</a><a class="btn outline" href="/problemloesungen/">Nach Hautbedürfnis</a></div>
  </div>
  <div class="hero-image">
    <img src="/images/hero-main.jpg" alt="Badestrand Kosmetik Editorial-Kampagne" width="1672" height="941" fetchpriority="high" decoding="async" />
    <div class="script-note">Mehr als Pflege. Ein Gefühl.</div>
  </div>
</section>
<TrustBar/>

<section class="section"><div class="container">
  <div class="section-head"><div><div class="eyebrow">Unsere Auswahl</div><h2>Pflege mit klarer Aufgabe.</h2></div><a class="btn outline" href="/produkte/">Alle Produkte →</a></div>
  <p class="lead" style="font-size:17px;margin:-18px 0 34px;max-width:640px;color:var(--muted)">Produkte, Wirkung und Anwendung werden bewusst einfach erklärt – vier Kernprodukte als Einstieg in die Marke.</p>
  <div class="product-grid">{products.map(p => <ProductCard product={p}/>)}</div>
</div></section>

<section class="section soft"><div class="container">
  <div class="section-head"><div><div class="eyebrow">Wissenschaft & Wirkstoffe</div><h2>Von der Formel zum Ergebnis.</h2></div><a class="btn outline" href="/inhaltsstoffe/">Alle Inhaltsstoffe →</a></div>
  <div class="editorial-grid">
    <article class="editorial-card"><img src="/images/ingredient-aloe-story.jpg" alt="" loading="lazy"><div class="content"><div class="eyebrow">Aloe Vera & Hyaluron</div><h3>Spürbare Feuchtigkeit.</h3><p>Zwei Wirkstoffe, eine Aufgabe – zu finden im Aloe Hyaluron Booster.</p><a href="/inhaltsstoffe/">Mehr erfahren →</a></div></article>
    <article class="editorial-card"><img src="/images/cream-texture.webp" alt="" loading="lazy"><div class="content"><div class="eyebrow">Urea</div><h3>Löst, was raue Haut braucht.</h3><a href="/produkte/hornhaut-balsam/">Zum Hornhaut Balsam →</a></div></article>
    <article class="editorial-card"><img src="/images/science-dropper.jpg" alt="" loading="lazy"><div class="content"><div class="eyebrow">Wirkstoffe mit Wirkung</div><h3>Wissenschaft trifft Natur.</h3><a href="/inhaltsstoffe/">Mehr erfahren →</a></div></article>
  </div>
</div></section>

<section class="section"><div class="container">
  <div class="section-head"><div><div class="eyebrow">Schneller finden</div><h2>Was braucht Ihre Haut?</h2></div><a class="btn outline" href="/problemloesungen/">Alle Problemlösungen →</a></div>
  <div class="concern-photo-grid">
    <a class="concern-photo" href="/problemloesungen/"><img src="/images/concern-hornhaut.jpg" alt="" loading="lazy" /><div class="content"><div class="eyebrow">01 · Hände & Füße</div><h3>Hornhaut & raue Haut</h3><span>Passende Pflege →</span></div></a>
    <a class="concern-photo" href="/problemloesungen/"><img src="/images/concern-pigment.jpg" alt="" loading="lazy" /><div class="content"><div class="eyebrow">02 · Gesicht</div><h3>Pigmentflecken</h3><span>Passende Pflege →</span></div></a>
    <a class="concern-photo" href="/problemloesungen/"><img src="/images/concern-feuchtigkeit.jpg" alt="" loading="lazy" /><div class="content"><div class="eyebrow">03 · Gesicht & Körper</div><h3>Feuchtigkeitsarme Haut</h3><span>Passende Pflege →</span></div></a>
    <a class="concern-photo" href="/problemloesungen/"><img src="/images/concern-reife-haut.jpg" alt="" loading="lazy" /><div class="content"><div class="eyebrow">04 · Gesicht</div><h3>Reife Haut</h3><span>Passende Pflege →</span></div></a>
  </div>
  <div class="concern-secondary-grid">
    <a class="concern" href="/problemloesungen/"><span class="num">05</span><h3>Rötungen & Couperose</h3><span>Passende Pflege →</span></a>
    <a class="concern" href="/problemloesungen/"><span class="num">06</span><h3>Hände & Füße</h3><span>Passende Pflege →</span></a>
  </div>
</div></section>

<section class="section dark"><div class="container">
  <div class="section-head"><div><div class="eyebrow">Produktbezogene Tests</div><h2>Ergebnisse, die Vertrauen schaffen.</h2></div><p>Testergebnisse werden immer beim konkreten Produkt erläutert und nicht pauschal auf das gesamte Sortiment übertragen.</p></div>
  <div class="proofs">
    <div class="proof"><strong>75%</strong><span>Hornhautreduzierung</span><small>Hornhaut Balsam · nach 28 Tagen, 2× täglich</small></div>
    <div class="proof"><strong>DE</strong><span>Hergestellt in Deutschland</span><small>Entwicklung und Produktion am Standort Deutschland</small></div>
    <div class="proof"><strong>0%</strong><span>Parabene*</span><small>*wo im jeweiligen Produkt bestätigt</small></div>
  </div>
</div></section>

<section class="brand-moment"><img src="/images/hero-family.jpg" alt="Badestrand Kosmetik Pflegeserie" loading="lazy" /><div class="content"><div class="eyebrow">Pflege mit Substanz</div><h2>Gezielt. Natürlich. Wirksam.</h2></div></section>

<section class="section"><div class="container split">
  <div class="split-media"><img src="/images/manufaktur.jpg" alt="Badestrand Kosmetik Herstellung (Konzeptdarstellung)" loading="lazy"></div>
  <div><div class="eyebrow">Herstellung</div><h2>Von der Formulierung bis zur fertigen Pflege.</h2><p class="lead">Sorgfältige Rezepturen, geprüfte Qualität und Herstellung in Deutschland – für Pflege, der man vertrauen kann.</p><a class="btn outline" href="/ueber-uns/">Mehr über Badestrand →</a></div>
</div></section>

<section class="section soft"><div class="container split">
  <div><div class="eyebrow">Persönliche Beratung</div><h2>Welche Pflege passt zu Ihrer Haut?</h2><p class="lead">Jede Haut ist unterschiedlich. Unser Team berät Sie persönlich zu Ihren individuellen Hautbedürfnissen.</p><div class="btns"><a class="btn" href="/kontakt/">Beratung kontaktieren →</a><a class="btn outline" href="/problemloesungen/">Pflegefinder starten</a></div></div>
  <div class="split-media"><img src="/images/consultation.jpg" alt="Persönliche Hautpflegeberatung" loading="lazy"></div>
</div></section>

<section class="brand-moment"><img src="/images/editorial-riviera.jpg" alt="Badestrand Kosmetik Editorial-Fotografie" loading="lazy" /><div class="content"><div class="eyebrow">Collector's Edit</div><h2>Mehr als Pflege.<br>Ein Lebensgefühl.</h2></div></section>

<section class="section soft"><div class="container">
  <div class="section-head"><div><div class="eyebrow">Magazin</div><h2>Hautwissen, das weiterhilft.</h2></div><a class="btn outline" href="/magazin/">Alle Artikel →</a></div>
  <div class="mag-teaser-grid">
    <a class="mag-card" href="/magazin/"><div class="content"><div class="eyebrow">Hautpflege</div><h3>Warum die Hautbarriere so wichtig ist.</h3><span>Artikel lesen →</span></div></a>
    <a class="mag-card" href="/magazin/"><div class="content"><div class="eyebrow">Inhaltsstoffe</div><h3>Hyaluron: mehr als nur Feuchtigkeit.</h3><span>Artikel lesen →</span></div></a>
    <a class="mag-card" href="/magazin/"><div class="content"><div class="eyebrow">Problemlösungen</div><h3>Hornhaut sinnvoll pflegen.</h3><span>Artikel lesen →</span></div></a>
  </div>
</div></section>

<section class="newsletter"><div class="container newsletter-inner">
  <div><div class="eyebrow">Newsletter</div><h2>Bleiben Sie informiert.</h2><p>Pflegetipps, neue Produkte und Neuigkeiten von Badestrand Kosmetik – direkt in Ihr Postfach.</p></div>
  <div>
    <!-- TODO: an E-Mail-Anbieter / Sanity-Formularverarbeitung anbinden -->
    <form class="newsletter-form" action="#" method="post">
      <label for="newsletter-email" class="visually-hidden">E-Mail-Adresse</label>
      <input id="newsletter-email" type="email" name="email" placeholder="Ihre E-Mail-Adresse" required />
      <button class="btn" type="submit">Anmelden →</button>
    </form>
    <p class="newsletter-note">Mit der Anmeldung stimmen Sie unserer Datenschutzerklärung zu. Abmeldung jederzeit möglich.</p>
  </div>
</div></section>
</SiteLayout>
