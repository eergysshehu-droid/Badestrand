---
import SiteLayout from '../../layouts/SiteLayout.astro';
import TrustBar from '../../components/TrustBar.astro';
import ProductCard from '../../components/ProductCard.astro';
import DermatologyBadge from '../../components/DermatologyBadge.astro';
import PaymentMethods from '../../components/PaymentMethods.astro';
import Icon from '../../components/Icon.astro';
import { products } from '../../data/products';
import { company } from '../../data/company';

// Sebum Plus Aufbaucreme has its own dedicated flagship page (richer source content)
export function getStaticPaths() {
  return products
    .filter((product) => product.slug !== 'sebum-plus-aufbaucreme')
    .map((product) => ({
      params: { slug: product.slug },
      props: { product }
    }));
}

const { product } = Astro.props;
const sameCategory = products.filter((p) => p.slug !== product.slug && p.category === product.category);
const related = (sameCategory.length > 0 ? sameCategory : products.filter((p) => p.slug !== product.slug)).slice(0, 4);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Produkte', item: `${company.domain}/produkte/` },
    { '@type': 'ListItem', position: 2, name: product.name, item: `${company.domain}/produkte/${product.slug}/` }
  ]
};

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  brand: { '@type': 'Brand', name: company.name },
  ...(product.priceVerified && product.price
    ? {
        offers: {
          '@type': 'Offer',
          priceCurrency: 'EUR',
          price: product.price.replace(/[^0-9,]/g, '').replace(',', '.'),
          availability: 'https://schema.org/InStock'
        }
      }
    : {})
};
---
<SiteLayout title={`${product.name} | Badestrand Kosmetik`} current="produkte" description={`${product.description} ${company.name} – ${product.eyebrow}.`}>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
<nav class="breadcrumbs container"><a href="/">Start</a><span>/</span><a href="/produkte/">Produkte</a><span>/</span><span>{product.name}</span></nav>
<section class="section"><div class="container product-detail">
  <div>
    {product.image ? (
      <>
        <div class="gallery-main"><img src={product.image} alt={product.name} /></div>
        <div class="gallery-thumbs">
          <div><img src={product.image} alt="" /></div>
          <div><img src="/images/cream-texture.webp" alt="" /></div>
          <div><img src="/images/products-wide.webp" alt="" /></div>
          <div><img src={product.image} alt="" /></div>
        </div>
      </>
    ) : (
      <div class="gallery-main"><div class="product-visual-placeholder"><span>{product.name.slice(0, 1)}</span><small>Foto folgt</small></div></div>
    )}
  </div>
  <div class="product-summary">
    <div class="eyebrow">{product.eyebrow}{product.size ? ` · ${product.size}` : ''}</div>
    <h1>{product.name}</h1>
    <p class="lead">{product.description}</p>
    {product.priceVerified ? (
      <div class="big-price">{product.price}</div>
    ) : (
      <div class="note">Preis wird vor Livegang final bestätigt.</div>
    )}
    <div class="btns" style="margin-top:20px"><button class="btn">In den Warenkorb →</button><button class="btn outline">♡</button></div>
    <PaymentMethods lang="de" compact />
    {product.availableOnAmazon && product.amazonUrl && (
      <a class="amazon-link" href={product.amazonUrl} target="_blank" rel="noopener noreferrer" data-amazon-link data-product-slug={product.slug} data-product-name={product.name} data-page-location="pdp">
        Auch bei Amazon erhältlich <Icon name="externalLink" size={13} />
      </a>
    )}
    {product.efficacy && (
      <div class="result"><b>{product.efficacy.value}</b><div>{product.efficacy.statement} {product.efficacy.context}</div></div>
    )}
    {product.study && (
      <div class="study-metrics-block">
        <div class="study-metrics-title">{product.study.title}</div>
        <div class="study-metrics-grid">
          {product.study.metrics.map((m) => (
            <div class="study-metrics-item"><strong>{m.value}</strong><span>{m.label}</span></div>
          ))}
        </div>
        <small>{product.study.context}</small>
      </div>
    )}
    {product.dermatologicallyTested && <DermatologyBadge lang="de" />}
    <div class="accordions">
      <details class="acc" open><summary>Beschreibung</summary><p>{product.description}</p></details>
      <details class="acc"><summary>Anwendung</summary><p>{product.application ?? 'Morgens und abends dünn und sparsam auftragen.'}</p></details>
      <details class="acc"><summary>Inhaltsstoffe</summary><p>Vollständige INCI-Angaben folgen vor Shop-Start.</p></details>
      <details class="acc"><summary>Wirkung & Ergebnisse</summary><p>{product.efficacy || product.study ? 'Testergebnisse siehe oben, mit Quellenhinweis vor Livegang.' : 'Für dieses Produkt liegen noch keine bestätigten Testergebnisse vor.'}</p></details>
    </div>
  </div>
</div></section>
<TrustBar/>
<section class="section soft"><div class="container"><div class="section-head"><div><div class="eyebrow">Dazu passt</div><h2>Pflege ergänzen.</h2></div></div><div class="product-grid">{related.map((p) => <ProductCard product={p} />)}</div></div></section>
</SiteLayout>
