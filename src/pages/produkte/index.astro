---
import SiteLayout from '../../layouts/SiteLayout.astro';
import TrustBar from '../../components/TrustBar.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';

const categories = ['Gesicht & Decolleté', 'Hände & Füße', 'Körper', 'Intimpflege'];
---
<SiteLayout title="Produkte | Badestrand Kosmetik" current="produkte">
<section class="page-hero"><div class="container"><div class="eyebrow">Badestrand Kosmetik</div><h1>Unsere Produkte</h1><p class="lead">Klare Navigation für Gesicht, Körper, Hände und Füße – mit direktem Zugang zu Hautbedürfnissen und Spezialpflege.</p></div></section>
<TrustBar/>
<section class="section section--standard"><div class="container-wide">
  <div class="filters" id="product-filters">
    <button class="pill active" data-filter="all">Alle</button>
    {categories.map((c) => <button class="pill" data-filter={c}>{c}</button>)}
  </div>
  <div class="catalog">
    <aside class="filter-panel"><h3>Filtern</h3><div class="filter-group"><strong>Kategorie</strong>{categories.map((c) => <label class="check"><input type="checkbox" disabled /> {c}</label>)}</div></aside>
    <div><div class="section-head" style="margin-bottom:18px"><p id="product-count">{products.length} Produkte</p><select><option>Empfohlen</option></select></div><div class="grid-3" id="product-grid">{products.map(p=><ProductCard product={p}/>)}</div></div>
  </div>
</div></section>
</SiteLayout>
<script>
  const pills = document.querySelectorAll('#product-filters .pill');
  const cards = document.querySelectorAll('#product-grid .product-card');
  const count = document.getElementById('product-count');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      const filter = pill.getAttribute('data-filter');
      let visible = 0;
      cards.forEach((card) => {
        const match = filter === 'all' || card.getAttribute('data-category') === filter;
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (count) count.textContent = `${visible} Produkte`;
    });
  });
</script>
