---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import TrustBar from '../../../components/TrustBar.astro';
import ProductCard from '../../../components/ProductCard.astro';
import DermatologyBadge from '../../../components/DermatologyBadge.astro';
import Icon from '../../../components/Icon.astro';
import { products } from '../../../data/products';
import { company } from '../../../data/company';

const product = products.find((p) => p.slug === 'sebum-plus-aufbaucreme')!;
const related = products.filter((p) => ['aloe-hyaluron-booster', 'rotalgen-aloe-hyaluron-konzentrat'].includes(p.slug));

const naturalProtection = ['Triglyceride', 'Fettsäuren', 'Cholesterin', 'Ceramide', 'Phospholipide', 'Squalan'];
const sebumPlusBase = ['Caprylic/Capric Triglyceride', 'Palmitinsäure', 'Phytosterole', 'Ceramide 3 / Ceramide NP', 'Phospholipide', 'Squalan'];

const keyIngredients = [
  { name: 'Olivenöl', copy: 'Reich an ungesättigten Fettsäuren, mit glättender Wirkung auf die Haut.' },
  { name: 'Cupuaçu-Butter', copy: 'Feuchtigkeitsspendend und hautschützend.' },
  { name: 'Squalan', copy: 'Unterstützt Hautfunktion, Feuchtigkeitsbindung und Einzugsvermögen.' },
  { name: 'Sheabutter', copy: 'Beruhigend, mit lipidauffüllender und feuchtigkeitsbewahrender Wirkung.' }
];

const formulaFacts = [
  'Ohne klassische Emulgatoren',
  'Keine klassische W/O- oder O/W-Emulsion',
  'Stabilisiert mit Lecithin',
  'Parfumfrei',
  'Farbstofffrei',
  'Ohne tierische Inhaltsstoffe laut vorliegender Rezepturangabe'
];

const qualityChecks = [
  'Prüfung auf mikrobiologische Reinheit',
  'Stabilitätsprüfung bei Wärme, Kälte und Temperaturwechsel',
  'Prüfung der Verpackungseignung',
  'Prüfung des Antioxidantiengehalts',
  'Hautverträglichkeitsprüfung',
  'Wirksamkeitsprüfung',
  'Sicherheitsbewertung des Fertigprodukts'
];

const faqs = [
  { q: 'Für welchen Hauttyp ist die Creme geeignet?', a: 'Sebum Plus Aufbaucreme wurde für trockene, empfindliche und reife Haut entwickelt.' },
  { q: 'Ist sie auch für die empfindliche Augenpartie geeignet?', a: 'Ja, die Formulierung ist für Gesicht, Augenpartie und Dekolleté konzipiert.' },
  { q: 'Enthält die Creme Parfum?', a: 'Nein, die Rezeptur ist parfumfrei.' },
  { q: 'Werden tierische Inhaltsstoffe verarbeitet?', a: 'Laut vorliegender Rezepturangabe enthält Sebum Plus keine tierischen Inhaltsstoffe.' },
  { q: 'Warum wird die Rezeptur als besonders hautverträglich beschrieben?', a: 'Die Cremebasis orientiert sich an der natürlichen Zusammensetzung des Hautschutzes und wurde in einer Hautverträglichkeitsprüfung über 48 und 72 Stunden an 50 Personen unterschiedlicher Hauttypen getestet – ohne berichtete Beanstandungen.' },
  { q: 'Mit welchen Produkten kann Sebum Plus kombiniert werden?', a: 'Sebum Plus lässt sich gut mit dem Aloe Hyaluron Booster oder dem Rotalgen Aloe Hyaluron Konzentrat ergänzen.' },
  { q: 'Wo wird Sebum Plus hergestellt?', a: 'Die Entwicklung und Herstellung erfolgt in Deutschland.' }
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Produkte', item: `${company.domain}/produkte/` },
    { '@type': 'ListItem', position: 2, name: product.name, item: `${company.domain}/produkte/${product.slug}/` }
  ]
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  brand: { '@type': 'Brand', name: company.name }
};
---
<SiteLayout title={`${product.name} | Badestrand Kosmetik`} current="produkte" description="Sebum Plus Aufbaucreme: Cremebasis nach dem Vorbild des natürlichen Hautschutzes, entwickelt für trockene, empfindliche und reife Haut.">
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
<nav class="breadcrumbs container"><a href="/">Start</a><span>/</span><a href="/produkte/">Produkte</a><span>/</span><span>{product.name}</span></nav>

<section class="section"><div class="container product-detail">
  <div>
    <div class="gallery-main"><img src={product.image} alt={product.name} /></div>
  </div>
  <div class="product-summary">
    <div class="eyebrow">{product.eyebrow} · {product.size}</div>
    <h1>{product.name}</h1>
    <p class="lead">{product.description}</p>
    <div class="note">Preis wird vor Livegang final bestätigt.</div>
    <div class="btns" style="margin-top:20px"><button class="btn">In den Warenkorb →</button><button class="btn outline">♡</button></div>
    {product.study && (
      <div class="study-metrics-block">
        <div class="study-metrics-title">{product.study.title}</div>
        <div class="study-metrics-grid">
          {product.study.metrics.map((m) => (
            <div class="study-metrics-item"><strong>{m.value}</strong><span>{m.label}</span></div>
          ))}
        </div>
        <small>{product.study.context}</small>
      </div>
    )}
    {product.dermatologicallyTested && <DermatologyBadge lang="de" />}
  </div>
</div></section>

<TrustBar/>

<section class="section section--standard soft"><div class="container" style="max-width:760px">
  <div class="eyebrow">Entwicklungsansatz</div>
  <h2>Eine Pflege, die sich am natürlichen Hautschutz orientiert.</h2>
  <p class="lead">Sebum Plus Aufbaucreme wurde als Pflege für Gesicht, Augenpartie und Dekolleté entwickelt – mit besonderem Blick auf trockene, empfindliche und reife Haut. Ziel der Formulierung ist es, alter, schlaffer Haut zu mehr jugendlichem Hautschutz und Frische zu verhelfen.</p>
</div></section>

<section class="section section--standard"><div class="container">
  <div class="eyebrow">Hautbarriere</div>
  <h2>Der natürliche Hautschutz als Vorbild.</h2>
  <p class="lead" style="max-width:640px">Die Cremebasis von Sebum Plus wurde mit Blick auf die natürliche Zusammensetzung des hauteigenen Fettfilms entwickelt. Ziel ist es, den natürlichen Hautschutz gezielt zu ergänzen.</p>
  <div class="barrier-grid">
    <div class="barrier-col"><h3>Natürlicher Hautschutz</h3><ul>{naturalProtection.map((i) => <li>{i}</li>)}</ul></div>
    <div class="barrier-col is-sebum"><h3>Sebum Plus Cremebasis</h3><ul>{sebumPlusBase.map((i) => <li>{i}</li>)}</ul></div>
  </div>
</div></section>

<section class="section section--standard soft"><div class="container">
  <div class="section-head"><div><div class="eyebrow">Ausgewählte Lipide & Pflegestoffe</div><h2>Was in der Formel steckt.</h2></div></div>
  <div class="grid-3">
    {keyIngredients.map((ing) => (
      <div class="ingredient"><div class="dot"><Icon name="droplet" size={22} /></div><h3>{ing.name}</h3><p>{ing.copy}</p></div>
    ))}
  </div>
</div></section>

<section class="section section--standard"><div class="container" style="max-width:820px">
  <div class="eyebrow">Formel-Fakten</div>
  <h2>Was die Rezeptur auszeichnet.</h2>
  <div class="fact-grid">
    {formulaFacts.map((fact) => (
      <div class="fact-item"><Icon name="shieldCheck" size={16} />{fact}</div>
    ))}
  </div>
</div></section>

<section class="section section--standard soft"><div class="container" style="max-width:820px">
  <div class="eyebrow">Qualität & Prüfungen</div>
  <h2>Sorgfalt, die man nicht sieht.</h2>
  <p class="lead" style="font-size:15px;color:var(--muted)">Diese Prüfungen gelten für Sebum Plus Aufbaucreme – nicht automatisch für das gesamte Sortiment.</p>
  <ul class="quality-list">
    {qualityChecks.map((check) => (
      <li><Icon name="shieldCheck" size={16} />{check}</li>
    ))}
  </ul>
  <div class="product-trust" style="margin-top:28px">
    <Icon name="germany" size={40} />
    <div><strong>Made in Germany</strong><p>Entwicklung und Herstellung erfolgen in Deutschland.</p></div>
  </div>
</div></section>

<section class="section section--standard"><div class="container" style="max-width:760px">
  <div class="section-head"><div><div class="eyebrow">FAQ</div><h2>Häufige Fragen.</h2></div></div>
  <div class="accordions">
    {faqs.map((f) => (
      <details class="acc"><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
    <details class="acc"><summary>Vollständige INCI</summary><p>Vollständige INCI-Angaben folgen vor Shop-Start.</p></details>
  </div>
</div></section>

<section class="section section--standard soft"><div class="container">
  <div class="section-head"><div><div class="eyebrow">Ergänzende Pflege</div><h2>Passt gut dazu.</h2></div></div>
  <div class="product-grid">{related.map((p) => <ProductCard product={p} />)}</div>
</div></section>

<section class="section"><div class="container consultation-cta">
  <h2>Fragen zu Sebum Plus?</h2>
  <p>Wir beraten Sie persönlich – {company.serviceHours.days} {company.serviceHours.time}.</p>
  <div class="btns"><a class="btn" href="/beratung/">Beratung kontaktieren →</a><a class="btn outline" href={`tel:${company.phone}`}>{company.phoneDisplay}</a></div>
</div></section>
</SiteLayout>
